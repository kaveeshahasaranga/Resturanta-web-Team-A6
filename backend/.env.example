# ─── Database ───────────────────────────────────
# MySQL (production)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/fuchsius_db"

# SQLite (local testing) — swap provider in schema.prisma to "sqlite"
# DATABASE_URL="file:./dev.db"

# ─── Server ─────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Auth ───────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ─── CORS ───────────────────────────────────────
FRONTEND_URL=http://localhost:5173
