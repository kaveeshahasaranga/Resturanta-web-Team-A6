// This is your Prisma schema file configured for SQLite (instant local development)
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("CUSTOMER")
  phone     String?
  city      String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@map("users")
}

model Chef {
  id          Int      @id @default(autoincrement())
  role        String   @default("HEARTH MASTER")
  name        String
  title       String
  subtitle    String?
  bio         String
  specialty   String
  image       String?
  badge       String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("chefs")
}

model MenuItem {
  id           Int          @id @default(autoincrement())
  name         String
  description  String
  price        Decimal
  category     String
  categoryInfo MenuCategory @relation(fields: [category], references: [code], onUpdate: Cascade, onDelete: Restrict)
  deletedAt    DateTime?
  image        String?
  isAvailable  Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  orderItems OrderItem[]

  @@map("menu_items")
}

model Order {
  id              Int      @id @default(autoincrement())
  customerName    String
  customerEmail   String
  customerPhone   String?
  deliveryAddress String?
  total           Decimal
  status          String   @default("PENDING")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  quantity   Int
  unitPrice  Decimal
  totalPrice Decimal

  orderId    Int
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  @@map("order_items")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

model MenuCategory {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       MenuItem[]

  @@map("menu_categories")
}

model PageContent {
  id          Int      @id @default(autoincrement())
  section     String   @unique
  title       String?
  description String?
  extraData   String?
  updatedAt   DateTime @updatedAt

  @@map("page_contents")
}


model AboutContent {
  id               Int      @id @default(autoincrement())
  section1Visible  Boolean  @default(true)
  heroSubNarrative String   
  heroImage        String?
  activeAmbience   String   @default("chimney")
  
  // Bottom Call To Action Banner
  bannerLive       Boolean  @default(true)
  bannerHeadline   String
  bannerSubtext    String   
  ctaButtonLabel   String
  targetRoute      String
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("about_content")
}

model CulinaryPillar {
  id           Int     @id @default(autoincrement())
  pillarNumber String  // "01", "02", "03"
  title        String
  eyebrow      String
  description  String  
  subText1     String
  subText2     String
  icon         String  // "flame", "pot", "spice"
  isActive     Boolean @default(true)

  @@map("culinary_pillars")
}

model FooterContent {
  id              Int      @id @default(autoincrement())
  brandName       String   @default("PRANEETHA")
  tagline         String   
  address         String   
  phone           String   
  email           String   
  hours           String   
  copyright       String   
  facebookUrl     String?
  instagramUrl    String?
  tripAdvisorUrl  String?
  updatedAt       DateTime @updatedAt

  @@map("footer_content")
}